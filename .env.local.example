# Local development environment. Copy to `.env` and tweak as needed.
#
# Use with:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
# and browse to http://localhost.
#
# Real `.env*` files are gitignored; this template is the only committed
# copy.

# Backend
ALLOWED_ORIGINS=http://localhost
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info
MAX_UPLOAD_SIZE_MB=15
MAX_BATCH_SIZE=25
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# TLS disabled locally. Leave CERTBOT_DOMAIN empty so the nginx HTTPS
# server block is not activated by the local config.
CERTBOT_DOMAIN=
CERTBOT_EMAIL=
CERTBOT_STAGING=false

# Frontend -> backend: same-origin via nginx, so the front-end uses /api
# and nginx reverse-proxies /api/* to the backend container.
VITE_API_BASE_URL=/api
