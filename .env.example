# ----------------------------------------------------------------------------
# AI-Powered Alcohol Label Verification - environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and edit for your local deployment.
# `docker compose up` reads the root .env automatically.
# Real .env files are gitignored. Never commit secrets.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Backend (FastAPI)
# ----------------------------------------------------------------------------

# Comma-separated list of origins allowed by CORS. Use the front-end's
# external URL in deployment; "*" is the dev default.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Uvicorn server config
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info

# Upload limits. Requests with a body larger than MAX_UPLOAD_SIZE_MB are
# rejected with 413. Batches with more than MAX_BATCH_SIZE images are
# rejected with 400.
MAX_UPLOAD_SIZE_MB=15
MAX_BATCH_SIZE=25

# PaddleOCR runtime
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# ----------------------------------------------------------------------------
# Frontend (Vite / React)
# ----------------------------------------------------------------------------

# Base URL the front-end uses to reach the backend. In Docker this is the
# service name + port; on the host it's localhost.
VITE_API_BASE_URL=http://localhost:8000
